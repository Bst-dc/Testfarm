# ============================================================
# 예시 설정 파일입니다. 실제 도메인을 정하시면 mydomain.com 을
# 전부 바꾸고, portal/README.md 안내대로 사용하세요.
# ============================================================
#
# Caddy 는 도메인/서브도메인별로 요청을 알아서 나눠주고(리버스 프록시),
# HTTPS 인증서도 자동으로 발급·갱신해준다. nginx보다 설정이 훨씬 짧다.
#
# 아래는 docker-compose.example.yml 로 Caddy까지 같은 컴포즈 안에서
# 띄우는 걸 기준으로 한다. 그래서 대상 주소를 localhost 가 아니라
# 컴포즈 서비스 이름(farm, smart-web)으로 쓴다 — 같은 도커 네트워크
# 안에서는 서비스 이름이 곧 호스트명이 된다.
# (만약 Caddy를 컨테이너 없이 VM에 직접 설치해 쓴다면, farm/smart-web
#  대신 각 컨테이너를 -p 로 publish 한 포트로 localhost:8501 처럼 쓰면 된다.)

# 허브(포털) 페이지 — 앱을 선택하는 첫 화면
mydomain.com {
    root * /var/www/portal
    file_server
}

# 시험농장 (이 저장소의 Streamlit 앱, 8501 포트)
farm.mydomain.com {
    reverse_proxy farm:8501
}

# 스마트웹시스템 (서비스 이름·포트는 실제 앱에 맞게 수정)
web.mydomain.com {
    reverse_proxy smart-web:3000
}
